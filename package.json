{
  "name": "ai-design-system-yomogi",
  "version": "1.0.0",
  "description": "AI-assisted lightweight design-system toolkit for Yomogi: tokens, components, page-generation rules, and measurable design checks.",
  "main": "index.js",
  "scripts": {
    "test": "npm run build-all",
    "storybook": "storybook dev",
    "build-storybook": "storybook build",
    "build-tokens": "style-dictionary build --config style-dictionary.config.js",
    "build-components": "node scripts/build-components-bundle.js",
    "build-page-assets": "node scripts/build-page-assets.js",
    "build-all": "npm run build-tokens && npm run build-components && npm run build-page-assets",
    "validate-page": "node scripts/validate-page.js",
    "dcs-report": "node scripts/dcs-report.js",
    "dcs-deep:install": "PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD=0 npx playwright install chromium",
    "export-package": "node scripts/export-package.js"
  },
  "keywords": [
    "design-system",
    "ai",
    "tokens",
    "components",
    "yomogi"
  ],
  "engines": {
    "node": ">=22.0.0"
  },
  "author": "",
  "license": "UNLICENSED",
  "private": true,
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@storybook/addon-backgrounds": "^8.6.18",
    "@storybook/addon-essentials": "^8.6.18",
    "@storybook/html-webpack5": "^8.6.18",
    "chrome-remote-interface": "^0.33.3",
    "pngjs": "^7.0.0",
    "storybook": "^8.6.18",
    "storybook-dark-mode": "^4.0.2",
    "style-dictionary": "^5.0.1",
    "wcag-contrast": "^3.0.0"
  },
  "dependencies": {
    "dotenv": "^17.2.3"
  }
}
